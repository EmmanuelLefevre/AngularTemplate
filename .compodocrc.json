{
  "assetsFolder": "public",
  "disableCoverage": true,
  "disableGraph": false,
  "disableInternal": true,
  "disablePrivate": true,
  "hideGenerator": true,
  "includes": "./docs",
  "open": true,
  "output": ".documentation-output",
  "port": 8080,
  "title": "AngularTemplate Documentation",
  "tsconfig": "tsconfig.doc.json"
}

/* ========================================================================
  COMPODOC CONFIGURATION (.compodocrc.json)

  This file defines the configuration settings for Compodoc, the documentation
  generator tool used for this Angular application.
  =========================================================================

  --- GENERAL SETTINGS ----------------------------------------------------

  * title: "AngularTemplate Documentation"
    Sets the title of the documentation, displayed in the browser tab and header.

  * tsconfig: "tsconfig.doc.json"
    Specifies the TypeScript configuration file to use for analysis.
    We use a dedicated file to exclude test files from the documentation.

  * port: 8080
    Defines the port number for the local documentation server (http://localhost:8080).

  * open: true
    Automatically opens the default web browser when the documentation server starts.

  --- OUTPUT & ASSETS -----------------------------------------------------

  * output: ".documentation-output"
    The destination directory where the generated static documentation site will be placed.

  * includes: "./docs"
    Path to the folder containing external Markdown files (Additional Documentation)
    to be included in the sidebar menu.

  * assetsFolder: "public"
    Defines the folder containing static assets (images, logos) to be copied
    to the documentation output folder.

  --- VISIBILITY & FEATURES -----------------------------------------------

  * disableCoverage: true
    Hides the documentation coverage report link from the sidebar menu.

  * disableGraph: false
    Enables the visual dependency graph (Graphviz) to show module relationships.

  * disableInternal: true
    Hides code elements (classes, methods) marked with the `@internal` JSDoc tag.

  * disablePrivate: true
    Excludes private class members (properties and methods) from the documentation
    to keep the API reference clean.

  * hideGenerator: true
    Removes the "Documentation generated by Compodoc" footer from the pages.
*/
