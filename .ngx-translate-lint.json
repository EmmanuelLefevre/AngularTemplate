{
  "languages": "./src/assets/i18n/*.json",
  "project": "./src/app/**/*.{html,ts}",
  "rules": {
    "deepSearch": "disable",
    "emptyKeys": "error",
    "ignoredKeys": [
      "(.*).mock",
      "ngIf",
      "ngFor",
      "LAYOUT\\.FOOTER\\.LEGAL\\.COPYRIGHT",
      "META\\..*",
      "TEST\\..*"
    ],
    "keysOnViews": "error",
    "maxWarning": "0",
    "misprintKeys": "disable",
    "zombieKeys": "warning"
  },
  "options": {
    "fullKeys": true
  }
}
