{
  "languages": "./src/assets/i18n/*.json",
  "project": "./src/app/**/*.{html,ts}",
  "rules": {
    "deepSearch": "disable",
    "emptyKeys": "error",
    "ignoredKeys": ["META\\..*", "LAYOUT\\.FOOTER\\.LEGAL\\.COPYRIGHT", "ngIf", "ngFor", "TEST\\..*", "(.*).mock"],
    "keysOnViews": "error",
    "maxWarning": "0",
    "misprintKeys": "disable",
    "zombieKeys": "warning"
  },
  "options": {
    "fullKeys": true
  }
}
